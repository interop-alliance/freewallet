{
  "name": "freewallet",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "prepare": "mkdir -p public/js && cp node_modules/credential-handler-polyfill/dist/* public/js/ && cp node_modules/web-credential-handler/dist/* public/js/",
    "start": "npx serve dist/ --cors",
    "dev": "vite --cors",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "fix": "npm run lint:fix && npm run format",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@digitalbazaar/webkms-client": "^14.3.0",
    "@digitalcredentials/ed25519-signature-2020": "^7.0.0",
    "@digitalcredentials/ezcap": "^6.1.0",
    "@digitalcredentials/http-client": "^5.0.4",
    "@digitalcredentials/ssi": "^5.4.2",
    "@digitalcredentials/verifier-core": "^1.0.0-beta.11",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/lab": "9.0.0-beta.2",
    "@mui/material": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "credential-handler-polyfill": "^4.0.1",
    "i18next": "^25.10.10",
    "json-canonicalize": "^2.0.0",
    "microlight": "^0.0.7",
    "query-string": "^9.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.7",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-password-strength-bar": "^0.4.1",
    "react-router": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "rxdb": "^16.21.1",
    "uuidv7": "^1.2.1",
    "web-credential-handler": "^3.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/microlight": "^0.0.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
